{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "KOINOS design tokens v1 — formato W3C Design Tokens. Importable por Figma Tokens Studio, Style Dictionary, theo. Espejo de design/tokens.css y src/app/globals.css.",
  "$version": "1.0.0",
  "$updated": "2026-05-09",

  "color": {
    "paper":      { "$value": "#fbf4dd", "$type": "color", "$description": "papel cálido, fondo de marca" },
    "cream":      { "$value": "#f4ead4", "$type": "color", "$description": "superficie secundaria, bandas" },
    "sand-lt":    { "$value": "#f0e0c0", "$type": "color", "$description": "hover, top-faces iso, highlights" },
    "sand":       { "$value": "#c8b898", "$type": "color", "$description": "tono base de edificio iso" },
    "ocre":       { "$value": "#b07840", "$type": "color", "$description": "pigmento mid-warm, links" },
    "ocre-dk":    { "$value": "#8a5a2a", "$type": "color", "$description": "sombra ocre, sub-marks, eyebrow" },
    "terracotta": { "$value": "#c85438", "$type": "color", "$description": "acento rojo plebeyo, alertas" },
    "sangre":     { "$value": "#6e2a1e", "$type": "color", "$description": "terracota oscuro, danger" },
    "aegean":     { "$value": "#5b9aa8", "$type": "color", "$description": "agua mediterránea" },
    "blue-dk":    { "$value": "#3a5878", "$type": "color", "$description": "imperial profundo, info" },
    "laurel":     { "$value": "#7c8a4a", "$type": "color", "$description": "verde cívico, success" },
    "gold":       { "$value": "#d8a44a", "$type": "color", "$description": "oro patricio, premio, warning" },
    "piedra":     { "$value": "#6d6458", "$type": "color", "$description": "gris cálido, texto secundario" },
    "volcanic":   { "$value": "#221d18", "$type": "color", "$description": "outline universal, tinta principal" },
    "line":       { "$value": "#e5e1d6", "$type": "color", "$description": "borde sutil de cards y separadores" },
    "surface":    { "$value": "#ffffff", "$type": "color", "$description": "blanco puro para cards y modales" }
  },

  "semantic-color": {
    "bg":        { "$value": "{color.paper}",     "$type": "color" },
    "bg-soft":   { "$value": "{color.cream}",     "$type": "color" },
    "ink":       { "$value": "{color.volcanic}",  "$type": "color" },
    "ink-muted": { "$value": "{color.piedra}",    "$type": "color" },
    "link":      { "$value": "{color.ocre}",      "$type": "color" },
    "danger":    { "$value": "{color.terracotta}","$type": "color" },
    "success":   { "$value": "{color.laurel}",    "$type": "color" },
    "warning":   { "$value": "{color.gold}",      "$type": "color" },
    "info":      { "$value": "{color.blue-dk}",   "$type": "color" }
  },

  "category-color": {
    "$description": "Paleta categórica para POIs y features de mapa. Fijada — no cambiar sin actualizar polis-juego.",
    "restauracion": { "$value": "{color.terracotta}", "$type": "color" },
    "comercio":     { "$value": "{color.blue-dk}",    "$type": "color" },
    "alojamiento":  { "$value": "{color.sangre}",     "$type": "color" },
    "salud":        { "$value": "{color.laurel}",     "$type": "color" },
    "finanzas":     { "$value": "{color.gold}",       "$type": "color" },
    "residencial":  { "$value": "{color.ocre}",       "$type": "color" },
    "publico":      { "$value": "{color.aegean}",     "$type": "color" },
    "monumento":    { "$value": "{color.volcanic}",   "$type": "color" }
  },

  "font-family": {
    "display": { "$value": "Archivo Black, Archivo, Helvetica Neue, sans-serif",     "$type": "fontFamily" },
    "sans":    { "$value": "Inter, ui-sans-serif, system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
    "mono":    { "$value": "JetBrains Mono, ui-monospace, SF Mono, Menlo, monospace", "$type": "fontFamily" }
  },

  "font-size": {
    "display": { "$value": "84px", "$type": "dimension", "$description": "hero, wordmark suelto" },
    "h1":      { "$value": "48px", "$type": "dimension" },
    "h2":      { "$value": "32px", "$type": "dimension" },
    "h3":      { "$value": "24px", "$type": "dimension" },
    "lg":      { "$value": "18px", "$type": "dimension", "$description": "lead, intro" },
    "base":    { "$value": "16px", "$type": "dimension", "$description": "prosa default" },
    "sm":      { "$value": "14px", "$type": "dimension", "$description": "UI secundaria" },
    "xs":      { "$value": "12px", "$type": "dimension", "$description": "metadatos, captions" },
    "eyebrow": { "$value": "11px", "$type": "dimension", "$description": "overline (uppercase + 0.18em tracking)" }
  },

  "line-height": {
    "tight":   { "$value": 1.1, "$type": "number" },
    "snug":    { "$value": 1.3, "$type": "number" },
    "normal":  { "$value": 1.5, "$type": "number" },
    "relaxed": { "$value": 1.6, "$type": "number" }
  },

  "space": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },

  "radius": {
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "md":   { "$value": "8px",    "$type": "dimension" },
    "lg":   { "$value": "12px",   "$type": "dimension" },
    "xl":   { "$value": "16px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },

  "duration": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "base": { "$value": "240ms", "$type": "duration" },
    "slow": { "$value": "400ms", "$type": "duration" }
  },

  "easing": {
    "out":    { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)", "$type": "cubicBezier" },
    "in-out": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",   "$type": "cubicBezier" }
  },

  "shadow": {
    "sutil": { "$value": "0 1px 2px rgba(34, 29, 24, 0.06)",   "$type": "shadow" },
    "carta": { "$value": "0 6px 24px -8px rgba(34, 29, 24, 0.16)", "$type": "shadow" },
    "foco":  { "$value": "0 0 0 3px rgba(176, 120, 64, 0.25)", "$type": "shadow" }
  }
}
